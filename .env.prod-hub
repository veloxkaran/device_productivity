# ── PRODUCTION hub (second instance; see docker-compose.envs.yml) ──────────────────────────────────────────
# Used by release.sh (baked into desktop apps + latest.json) AND by the
# hub container (docker compose --env-file .env.production).

# The PRODUCTION backend. Never the hub's own URL.
HAJIR_API_URL=https://CHANGE-ME-production-api/api/v2
HUB_URL=https://CHANGE-ME-production-hub
HUB_PUBLIC_URL=https://CHANGE-ME-production-hub
# Comma-separated dashboard origins allowed by CORS. Add the employer
# dashboard URL here if it is served from a different domain.
HUB_ALLOWED_ORIGINS=https://CHANGE-ME-production-dashboard
HUB_TIMEZONE=Asia/Kathmandu
# Secret — set on the server, keep blank in git:
HUB_INTERNAL_KEY=
