# ── staging environment ──────────────────────────────────────────
# Used by release.sh (baked into desktop apps + latest.json) AND by the
# hub container (docker compose --env-file .env.staging).

HAJIR_API_URL=https://monitor.veloxlabs.net/api/v2
HUB_URL=https://monitor.veloxlabs.net
HUB_PUBLIC_URL=https://monitor.veloxlabs.net
# Comma-separated dashboard origins allowed by CORS. Add the employer
# dashboard URL here if it is served from a different domain.
HUB_ALLOWED_ORIGINS=https://devdash.veloxlabs.net,https://monitor.veloxlabs.net
HUB_TIMEZONE=Asia/Kathmandu
# Secret — set on the server, keep blank in git:
HUB_INTERNAL_KEY=
